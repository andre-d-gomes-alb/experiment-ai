# Import libraries
import pandas as pd
import os
import sys

#---------------------------------------------------------#
# 2. Configuration & Loading                              #
#---------------------------------------------------------#
# Ensure the model is in the same directory as this script (or change the 'model_uri' accordingly)
model_uri = "./"

# Set to True to use MLflow, or False to load the binary directly (lighter)
USE_MLFLOW = True

if USE_MLFLOW:
    try:
        import mlflow

        {%- if 'python_function' in v_flavors -%}
            {%- set loader = 'pyfunc' -%}
        {%- else -%}
            {%- set loader = v_flavors[0] if v_flavors else 'pyfunc' -%}
        {%- endif %}

        # Loading the model using the '{{ loader }}' flavor
        # Available flavors interface for this model: {{ v_flavors|join(', ')|replace('python_function', 'pyfunc') if v_flavors else 'No available flavors'}}
        model = mlflow.{{ loader }}.load_model(model_uri)

        print("✅ Model loaded successfully using MLflow ({{ loader }}).")
    except Exception as e:
        print(f"❌ Error loading the model with MLflow ({{ loader }}): {e}")
        sys.exit(1)
else:
    try:
        import joblib

        # Search for model file .pkl (add this info manually for improved efficiency)
        binary_path = next((os.path.join(r, f) for r, d, fs in os.walk(model_uri) for f in fs if f.endswith(".pkl")), None)
        if not binary_path: 
            raise FileNotFoundError("No .pkl found.")
        
        model = joblib.load(binary_path)

        print(f"✅ Model loaded successfully, using joblib, from: {binary_path}")
    except Exception as e:
        print(f"❌ Error loading the model with joblib: {e}")
        sys.exit(1)

#---------------------------------------------------------#
