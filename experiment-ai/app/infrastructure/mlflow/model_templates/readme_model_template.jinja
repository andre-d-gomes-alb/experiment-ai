    if data_example:
        input_data = pd.DataFrame(pd.read_json(model_uri + data_example["artifact_path"], orient='split'))
    else:
        input_data = pd.DataFrame(data_example)
except Exception as e:
    print(f"❌ Error reading input example: {e}")
    sys.exit(1)

